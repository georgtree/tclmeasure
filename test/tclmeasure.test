    test VectorInput-namespace {unqualified and relative names resolve in measure's caller} -setup {
        namespace eval ::measureCaller {
            namespace eval signals {
                rbc::vector create x y
                x set {0 1 2 3}
                y set {0 2 4 6}
            }
            proc run {} {
                ::tclmeasure::measure -xname signals::x -find signals::y -at 0.5
            }
        }
    } -body {
        ::measureCaller::run
    } -result 1.0 -cleanup {
        namespace delete ::measureCaller
    }

    test VectorInput-noarray {mapping is unnecessary, offsets do not affect sample positions} -setup {
        rbc::vector create ::inputX ::inputY
        ::inputX set {0 1 2 3}
        ::inputY set {0 2 4 6}
        ::inputX variable {}
        ::inputY variable {}
        ::inputX offset -10
        ::inputY offset 20
    } -body {
        list [::tclmeasure::measure -xname ::inputX -avg {-vec ::inputY}] \
             [::tclmeasure::measure -xname ::inputX -find ::inputY -at 0.5]
    } -result {3.0 1.0} -cleanup {
        rbc::vector destroy ::inputX ::inputY
    }

    test VectorInput-missing {missing command gets a useful error} -body {
        ::tclmeasure::measure -xname x -find ::notAVector -at 1
    } -returnCodes error -result {vector command "::notAVector" does not exist}

    test VectorInput-notvector {C validates that an existing command is an RBC vector} -setup {
        proc ::notAVector {args} {
            error "this command must not be invoked"
        }
    } -body {
        catch {::tclmeasure::measure -xname x -find ::notAVector -at 1} message
        expr {[string match {*notAVector*} $message] && ![string match {*must not be invoked*} $message]}
    } -result 1 -cleanup {
        rename ::notAVector {}
    }

    test VectorInput-complex {complex input is rejected} -setup {
        rbc::vector create ::complexInput -type complex
        ::complexInput set {{0 1} {1 2} {2 3}}
    } -body {
        ::tclmeasure::measure -xname x -find ::complexInput -at 1
    } -returnCodes error -result {vector "::complexInput" must contain real values} -cleanup {
        rbc::vector destroy ::complexInput
    }

    test VectorInput-length {vector lengths must agree} -setup {
        rbc::vector create ::shortInput
        ::shortInput set {1 2}
    } -body {
        ::tclmeasure::measure -xname x -find ::shortInput -at 1
    } -returnCodes error -result {Length of x '1001' is not equal to length of findVec '2'} -cleanup {
        rbc::vector destroy ::shortInput
    }

    test VectorInput-short {derivatives require three samples} -setup {
        rbc::vector create ::shortInput
        ::shortInput set {0 1}
    } -body {
        ::tclmeasure::measure -xname ::shortInput -deriv ::shortInput -at 0.5
    } -returnCodes error -result {not enough samples for measurement} -cleanup {
        rbc::vector destroy ::shortInput
    }

    test VectorInput-direct {direct C vector entry point preserves Tcl results} -body {
        ::tclmeasure::TrigTargVectors ::x ::x 5.01 ::y2 0.5 rise 1 cross 2 0 0
    } -match approxEqual -result {xtrig 5.01 xtarg 5.236130584737532 xdelta 0.22613058473753256}

    test VectorInput-list {list commands still accept lists while RBC is loaded} -body {
        ::tclmeasure::FindAt {0 1 2} 0.5 {0 2 4}
    } -result 1.0

    test VectorInput-unchanged {no input mutation or full-list extraction by the wrapper} -setup {
        set beforeX [x index :]
        set beforeY [y1 index :]
        set beforeNames [lsort [rbc::vector names]]
        proc ::rejectFullVectorRead {command operation} {
            if {[lrange $command 1 end] eq {index :}} {
                error "full vector extraction is forbidden"
            }
        }
        trace add execution ::x enter ::rejectFullVectorRead
        trace add execution ::y1 enter ::rejectFullVectorRead
    } -body {
        set result [::tclmeasure::measure -xname x -rms {-vec y1 -from 4 -to 25}]
        expr {[string is double -strict $result] && $beforeNames eq [lsort [rbc::vector names]]}
    } -result 1 -cleanup {
        trace remove execution ::x enter ::rejectFullVectorRead
        trace remove execution ::y1 enter ::rejectFullVectorRead
        rename ::rejectFullVectorRead {}
        if {$beforeX ne [x index :] || $beforeY ne [y1 index :]} {
            error "measurement changed input samples"
        }
        unset beforeX beforeY beforeNames result
    }

    test VectorInput-interpreter {stubs are initialized in each interpreter, not inferred from a global pointer}\
            -setup {
        set measureLibrary [lindex [lsearch -inline -index 1 [info loaded] Tclmeasure] 0]
        set rbcLibrary [lindex [lsearch -inline -index 1 [info loaded] Rbc] 0]
        interp create measureChild
        measureChild eval [list load $measureLibrary Tclmeasure]
        measureChild eval [list package ifneeded rbc::vector [package present rbc::vector] [list load $rbcLibrary Rbc]]
    } -body {
        measureChild eval {
            set before [catch {package present rbc::vector}]
            set listValue [::tclmeasure::FindAt {0 1 2} 0.5 {0 2 4}]
            set afterList [catch {package present rbc::vector}]
            # Direct vector input initializes RBC here even though its stubs are already set in the parent.
            catch {::tclmeasure::FindAtVectors ::cx 0.5 ::cy}
            set afterVector [catch {package present rbc::vector}]
            rbc::vector create ::cx ::cy
            ::cx set {0 1 2}
            ::cy set {0 2 4}
            list $before $listValue $afterList $afterVector [::tclmeasure::FindAtVectors ::cx 0.5 ::cy]
        }
    } -result {1 1.0 1 0 1.0} -cleanup {
        interp delete measureChild
        unset measureLibrary rbcLibrary
    }

    rbc::vector destroy x y1 y2 xsym y1sym y2sym xloc yloc
}

test Input-invalid {invalid numeric list samples propagate errors} -body {
    ::tclmeasure::FindAt {0 1 2} 0.5 {0 bad 4}
} -returnCodes error -match glob -result {*expected floating-point number*}

test Input-empty {empty input is rejected before accessing endpoints} -body {
    ::tclmeasure::Integ {} {} 0 1 false
} -returnCodes error -result {not enough samples for measurement}

cleanupTests
