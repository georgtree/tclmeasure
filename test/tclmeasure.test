# Vector cases deliberately use the same measurements and expected Tcl results as the list cases above.
# Loading RBC is optional; a list-only tclmeasure build also skips the direct-vector cases.
if {![catch {package require rbc::vector}] && ![catch {::tclmeasure::VectorSupport}]} {
    unset x y1 y2 xsym y1sym y2sym
    rbc::vector create x y1 y2 xsym y1sym y2sym xloc yloc
    for {set i 0} {$i<=1000} {incr i} {
        set xi [expr {$i*0.05}]
        x append $xi
        y1 append [expr {sin($xi)}]
        y2 append [expr {cos($xi)}]
    }
    for {set i -500} {$i<=500} {incr i} {
        set xi [expr {$i*0.05}]
        xsym append $xi
        y1sym append [expr {sin($xi)}]
        y2sym append [expr {cos($xi)}]
    }

    test Vector-TrigTargTest-1 {} -match approxEqual -body {
        return [::tclmeasure::measure -xname x -trig {-vec y1 -val 0.1 -rise 3} -targ {-vec y2 -val 0.5 -fall 5}]
    } -result {xtrig 12.666567432668222 xtarg 26.17976390163929 xdelta 13.513196468971069}

    test Vector-TrigTargTest-2 {} -match approxEqual -body {
        return [::tclmeasure::measure -xname x -trig {-vec y1 -val 0.7 -rise 2} -targ {-at 20.0}]
    } -result {xtrig 7.058761869929844 xtarg 20.0 xdelta 12.941238130070156}

    test Vector-TrigTargTest-3 {} -match approxEqual -body {
        return [::tclmeasure::measure -xname x -trig {-at 5.01} -targ {-vec y2 -val 0.5 -cross 2}]
    } -result {xtrig 5.01 xtarg 5.236130584737532 xdelta 0.22613058473753256}

    test Vector-TrigTargTest-4 {} -match approxEqual -body {
        return [::tclmeasure::measure -xname x -trig {-vec x -val 5.01 -rise 1} -targ {-vec y2 -val 0.5 -fall last}]
    } -result {xtrig 5.01 xtarg 45.029318738629485 xdelta 40.01931873862949}

    test Vector-TrigTargTest-5 {} -match approxEqual -body {
        return [::tclmeasure::measure -xname x -trig {-vec y1 -val 0.1 -rise last} -targ {-vec y2 -val 0.5 -fall last}]
    } -result {xtrig 44.08249174375871 xtarg 45.029318738629485 xdelta 0.9468269948707757}

    test Vector-TrigTargTest-6 {} -body {
        catch {::tclmeasure::measure -xname x -trig {-vec y1 -val 0.1 -rise last} -targ {-vec y2 -val 2.0 -fall last}}\
                errorStr
        return $errorStr
    } -result {Targ value '2.000000' with conditions 'fall last delay=0.000000' was not found}

    test Vector-TrigTargTest-7 {} -body {
        catch {::tclmeasure::measure -xname x -trig {-vec y1 -val 0.1 -rise last} -targ {-vec y2 -val -0.1 -fall 20}}\
                errorStr
        return $errorStr
    } -result {Targ value '-0.100000' with conditions 'fall 20 delay=0.000000' was not found}

