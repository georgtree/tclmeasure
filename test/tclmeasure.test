### Check handling of wrong switches combinations
test CheckTest-1 {} -body {
    catch {::tclmeasure::measure -xname x -data [dict create x $x y1 $y1 y2 $y2] -at 5} errorStr
    return $errorStr
} -result {When -at switch is presented, -find switch or -deriv switch is required} -cleanup {
    unset errorStr
}

test CheckTest-2 {} -body {
    catch {::tclmeasure::measure -xname x -data [dict create x $x y1 $y1 y2 $y2] -find 5} errorStr
    return $errorStr
} -result {When -find switch is presented, -when switch or -at switch is required} -cleanup {
    unset errorStr
}

test CheckTest-3 {} -body {
    catch {::tclmeasure::measure -xname x -data [dict create x $x y1 $y1 y2 $y2] -when 5 -at 1} errorStr
    return $errorStr
} -result {when doesn't allow at} -cleanup {
    unset errorStr
}

test CheckTest-4 {} -body {
    catch {::tclmeasure::measure -xname x -data [dict create x $x y1 $y1 y2 $y2] -deriv 5 -find 1} errorStr
    return $errorStr
} -result {find doesn't allow deriv} -cleanup {
    unset errorStr
}

### Integ tests
test IntegTest-1 {} -match approxEqual -body {
    return [::tclmeasure::measure -xname x -data [dict create x $x y1 $y1] -integ {-vec y1 -from 4 -to 25}]
} -result -1.6445037421079023

test IntegTest-2 {} -match approxEqual -body {
    set xloc {0 1 2 3 4 5}
    set yloc {0 1 4 9 16 25}
    return [::tclmeasure::measure -xname x -data [dict create x $xloc y $yloc] -integ {-vec y -from 0.5 -to 4.5}]
} -result 31.0 -cleanup {
    unset xloc yloc
}

test IntegTest-3 {} -match approxEqual -body {
