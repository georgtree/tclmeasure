    test Vector-MaxatTest-2 {} -match approxEqual -body {
        return [::tclmeasure::measure -xname x -maxat {-vec y1}]
    } -result 45.550000000000004

    test Vector-MaxatTest-3 {} -match approxEqual -body {
        xloc set {0 1 2 3 4 5}
        yloc set {0 1 4 9 16 25}
        return [::tclmeasure::measure -xname xloc -maxat {-vec yloc -from 0.0 -to 5}]
    } -result 5.0 -cleanup {
        xloc set {}
        yloc set {}
    }

